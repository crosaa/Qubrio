# Copy this file to `.env` (which is gitignored) and fill in your API keys.
# Set at least one — the rest can be left blank. The chosen backbone is
# selected at runtime via --provider {deepseek, openai, qwen}.
#
# `qwen` is reached through OpenRouter (with first-party Alibaba pinned).

DEEPSEEK_API_KEY=sk-...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
